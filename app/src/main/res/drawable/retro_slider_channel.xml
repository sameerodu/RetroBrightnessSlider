<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer recessed edge -->
    <item>
        <shape android:shape="rectangle">

            <solid android:color="#4A4035" />

            <corners android:radius="1000dp" />

        </shape>
    </item>

    <!-- Deep interior -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">

        <shape android:shape="rectangle">

            <gradient
                android:angle="90"
                android:startColor="#181513"
                android:centerColor="#30271F"
                android:endColor="#120F0D" />

            <corners android:radius="1000dp" />

        </shape>

    </item>

    <!-- Fine inner rim -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">

        <shape android:shape="rectangle">

            <stroke
                android:width="1dp"
                android:color="#665848" />

            <solid android:color="@android:color/transparent" />

            <corners android:radius="1000dp" />

        </shape>

    </item>

</layer-list>
