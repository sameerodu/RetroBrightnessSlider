<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Dark outer edge -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#3A352F" />
            <corners android:radius="1000dp" />
        </shape>
    </item>

    <!-- Warm metallic body -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">

        <shape android:shape="rectangle">

            <gradient
                android:angle="90"
                android:startColor="#C7B99F"
                android:centerColor="#F0E4CD"
                android:endColor="#A99A83" />

            <corners android:radius="1000dp" />

        </shape>

    </item>

    <!-- Soft inner highlight -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">

        <shape android:shape="rectangle">

            <stroke
                android:width="1dp"
                android:color="#FFF7E6" />

            <solid android:color="@android:color/transparent" />

            <corners android:radius="1000dp" />

        </shape>

    </item>

</layer-list>
