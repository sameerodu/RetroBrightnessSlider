<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Deep shadow -->
    <item
        android:left="2dp"
        android:top="3dp"
        android:right="0dp"
        android:bottom="0dp">

        <shape android:shape="oval">

            <solid android:color="#302B26" />

        </shape>

    </item>

    <!-- Dark metal outer rim -->
    <item
        android:right="1dp"
        android:bottom="2dp">

        <shape android:shape="oval">

            <gradient
                android:angle="315"
                android:startColor="#4B463F"
                android:centerColor="#D4C9B7"
                android:endColor="#625B52" />

            <stroke
                android:width="1dp"
                android:color="#302D29" />

        </shape>

    </item>

    <!-- Main metal surface -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="5dp"
        android:bottom="6dp">

        <shape android:shape="oval">

            <gradient
                android:angle="315"
                android:startColor="#FFF8E9"
                android:centerColor="#D8CCB9"
                android:endColor="#82786B" />

        </shape>

    </item>

    <!-- Small highlight -->
    <item
        android:left="8dp"
        android:top="7dp"
        android:right="17dp"
        android:bottom="17dp">

        <shape android:shape="oval">

            <solid android:color="#FFFDF5" />

        </shape>

    </item>

</layer-list>
